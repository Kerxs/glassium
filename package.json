{
  "name": "glassium",
  "version": "0.0.0",
  "private": true,
  "description": "Liquid Glass 渲染框架 —— Web/TypeScript 实现",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./glassium.css": "./dist/glassium.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:lib": "tsc -p tsconfig.build.json && node scripts/copy-css.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test",
    "gen:conformance": "node scripts/gen-conformance.ts",
    "gen:glsl": "node scripts/gen-glsl.ts",
    "prepare": "npm run build:lib"
  },
  "dependencies": {
    "@webgpu/types": "^0.1.60"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  },
  "engines": {
    "node": ">=20"
  }
}
